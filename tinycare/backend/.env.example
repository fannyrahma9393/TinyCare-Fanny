[TEMPLATE]
APP_NAME=TinyCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tinycare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tinycare.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

# Admin Access Code — validated server-side only, never exposed to frontend
# IMPORTANT: Change this to a strong, unique code in production!
# Do NOT use the default value in production environments.
TINYCARE_ADMIN_ACCESS_CODE=CHANGE-ME-IN-PRODUCTION

# Payment Gateway
# Provider: manual_transfer (default/sandbox) | midtrans | xendit
PAYMENT_PROVIDER=manual_transfer
PAYMENT_IS_SANDBOX=true
# PAYMENT_SERVER_KEY=SB-Mid-server-xxxx
# PAYMENT_CLIENT_KEY=SB-Mid-client-xxxx
# PAYMENT_MERCHANT_ID=xxxx
# PAYMENT_WEBHOOK_SECRET=xxxx

# Firebase Cloud Messaging (FCM) — push notifications to parent browsers
# ---------------------------------------------------------------
# Backend uses the FCM HTTP v1 API via Guzzle with a Google service-account JWT.
# These values come from the service-account JSON (Firebase Console ->
# Project settings -> Service accounts -> Generate new private key).
# NEVER commit the real values. When these are empty, FCM messages are logged
# instead of sent so the app continues to work.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key must be the full PEM value from the service-account JSON. In the
# JSON it contains literal "\n" sequences; keep them escaped like below.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production Settings
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tinycare.com

# DB_HOST=your-production-db-host
# DB_DATABASE=tinycare_production
# DB_USERNAME=your-db-username
# DB_PASSWORD=your-secure-password

# REDIS_PASSWORD=your-redis-password

# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your-mail-username
# MAIL_PASSWORD=your-mail-password

# SANCTUM_STATEFUL_DOMAINS=yourdomain.com,admin.yourdomain.com
