# TinyCare Web — environment variables
# ---------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit secrets.

# Backend API base URL (relative uses the Vite dev proxy to localhost:8000)
VITE_API_URL=/api/v1

# Firebase Web config (PUBLIC values only — safe to expose).
# These come from: Firebase Console -> Project settings -> Your apps -> Web app.
# They are NOT secrets. Private credentials (service-account JSON) must NEVER
# be placed here — those belong only in the backend .env (FIREBASE_*).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID public key (from Firebase Cloud Messaging settings). Also not secret.
VITE_FIREBASE_VAPID_KEY=
